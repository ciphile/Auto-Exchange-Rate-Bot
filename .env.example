# Danh sách TÊN biến môi trường — KHÔNG ghi giá trị thật vào file này (Rule 4).
# Giá trị thật chỉ dán trên Vercel: Settings → Environment Variables (xem docs/huong-dan-cai-dat.md).
# Thêm / đổi 1 biến = sửa đủ 4 nơi cùng commit: src/config/env.ts · file này · hướng dẫn cài đặt · FS phụ lục D.

# Bot Rây (bắt buộc)
RAY_BOT_TOKEN=
RAY_WEBHOOK_SECRET=
# Bot Lũi (để trống cho tới khi làm Lũi; có thì phải đủ cả 2)
LUI_BOT_TOKEN=
LUI_WEBHOOK_SECRET=
# Mã tài khoản Telegram của Khang (dãy số)
OWNER_TELEGRAM_ID=
# Google AI Studio (Gemini miễn phí)
GEMINI_API_KEY=
# Supabase
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Khóa mã hóa kho tin nhắn + log prompt (64 ký tự hex)
DATA_ENCRYPTION_KEY=
# Mã Bearer cho nhịp lịch /api/tick
TICK_SECRET=
